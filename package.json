{
  "name": "databricks-bundle-inspector",
  "displayName": "Databricks Bundle Inspector",
  "description": "Find Databricks bundle problems before you deploy, including ones bundle validate misses. See them in your code and explore how your jobs and tasks connect.",
  "version": "0.6.1",
  "publisher": "UncoverTheStack",
  "icon": "resources/icon.png",
  "license": "Apache-2.0",
  "type": "module",
  "categories": [
    "Linters",
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "databricks",
    "databricks asset bundles",
    "declarative automation bundles",
    "dab",
    "dabs",
    "bundle validate",
    "lakeflow jobs",
    "lakeflow spark declarative pipelines",
    "spark declarative pipelines",
    "delta live tables",
    "dlt",
    "databricks jobs",
    "databricks.yml",
    "yaml",
    "linter",
    "validation",
    "secrets",
    "dag",
    "visualization"
  ],
  "engines": {
    "vscode": "^1.100.0",
    "node": "24.x"
  },
  "homepage": "https://github.com/uncoverthestack/databricks-bundle-inspector",
  "qna": "https://github.com/uncoverthestack/databricks-bundle-inspector/issues",
  "bugs": {
    "url": "https://github.com/uncoverthestack/databricks-bundle-inspector/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uncoverthestack/databricks-bundle-inspector.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/databricks.yml",
    "workspaceContains:**/databricks.yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension runs the Databricks CLI on files in your workspace, so the folder must be trusted first."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "databricksBundleInspector.inspectBundle",
        "title": "Open Graph",
        "category": "Databricks Bundle Inspector",
        "enablement": "resourceFilename =~ /^databricks\\.ya?ml$/ || databricksBundleInspector.activeFileInBundle",
        "icon": {
          "light": "resources/inspect-light.svg",
          "dark": "resources/inspect-dark.svg"
        }
      },
      {
        "command": "databricksBundleInspector.openBundleIssues",
        "title": "Open Bundle Issues"
      },
      {
        "command": "databricksBundleInspector.chooseProfile",
        "title": "Choose Databricks Login Profile",
        "icon": "$(edit)"
      },
      {
        "command": "databricksBundleInspector.copySelection",
        "title": "Copy"
      },
      {
        "command": "databricksBundleInspector.sidebar.inspect",
        "title": "Open Graph",
        "icon": {
          "light": "resources/inspect-light.svg",
          "dark": "resources/inspect-dark.svg"
        }
      },
      {
        "command": "databricksBundleInspector.sidebar.openBundleFile",
        "title": "Open Bundle File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "databricksBundleInspector.sidebar.checkAgain",
        "title": "Check Again",
        "icon": "$(refresh)"
      },
      {
        "command": "databricksBundleInspector.sidebar.openTarget",
        "title": "Open Target"
      },
      {
        "command": "databricksBundleInspector.sidebar.openProblems",
        "title": "Open Bundle Problems"
      },
      {
        "command": "databricksBundleInspector.sidebar.openSignInTerminal",
        "title": "Open Sign-in Terminal",
        "icon": "$(key)"
      },
      {
        "command": "databricksBundleInspector.checkAllBundles",
        "title": "Check All Databricks Bundles Again",
        "icon": "$(refresh)"
      },
      {
        "command": "databricksBundleInspector.sidebar.checkAll",
        "title": "Check All Databricks Bundles Again",
        "icon": "$(refresh)"
      },
      {
        "command": "databricksBundleInspector.openGuide",
        "title": "Open the Databricks Bundle Inspector Guide",
        "icon": "$(book)"
      },
      {
        "command": "databricksBundleInspector.reportIssue",
        "title": "Report a Databricks Bundle Inspector Issue",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "databricksBundleInspector.chooseCli",
        "title": "Choose the Databricks CLI…",
        "icon": "$(edit)"
      },
      {
        "command": "databricksBundleInspector.locateCli",
        "title": "Locate the Databricks CLI…",
        "icon": "$(folder-opened)"
      },
      {
        "command": "databricksBundleInspector.openCliInstallGuide",
        "title": "Open the Databricks CLI Install Guide",
        "icon": "$(link-external)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "databricksBundleInspector",
          "title": "Databricks Bundle Inspector",
          "icon": "resources/sidebar.svg"
        }
      ]
    },
    "views": {
      "databricksBundleInspector": [
        {
          "id": "databricksBundleInspector.bundles",
          "name": "Bundles",
          "icon": "resources/sidebar.svg",
          "contextualTitle": "Databricks Bundle Inspector"
        },
        {
          "id": "databricksBundleInspector.settings",
          "name": "Settings",
          "icon": "resources/sidebar.svg",
          "contextualTitle": "Databricks Bundle Inspector"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "databricksBundleInspector.bundles",
        "contents": "Open the folder that holds your databricks.yml to check it here. Checks run without signing in.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "databricksBundleInspector.bundles",
        "contents": "Looking for bundles…",
        "when": "workspaceFolderCount > 0 && !databricksBundleInspector.bundlesSearched"
      },
      {
        "view": "databricksBundleInspector.bundles",
        "contents": "No bundle found in the open folders. Databricks Bundle Inspector checks folders that hold a databricks.yml or databricks.yaml file. [Read the usage guide](command:databricksBundleInspector.openGuide)",
        "when": "workspaceFolderCount > 0 && databricksBundleInspector.bundlesSearched"
      }
    ],
    "configuration": {
      "title": "Databricks Bundle Inspector",
      "properties": {
        "databricksBundleInspector.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional path to the Databricks CLI executable. When empty, the extension uses databricks from PATH."
        },
        "databricksBundleInspector.profile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Profile from `~/.databrickscfg` to use when you pick a target in the graph. Needed when several profiles point at the same workspace; the graph then offers to choose one. Set it with the **Choose Databricks Login Profile** command. Not used by the structural preview, which needs no login."
        },
        "databricksBundleInspector.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Send anonymous usage data (features used, never paths, names or file contents) to help improve the extension. Nothing is sent when `#telemetry.telemetryLevel#` is not `all`, regardless of this setting. [What is collected](https://github.com/uncoverthestack/databricks-bundle-inspector#telemetry)",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "databricksBundleInspector.inspectBundle",
          "group": "navigation",
          "when": "resourceFilename =~ /^databricks\\.ya?ml$/ || databricksBundleInspector.activeFileInBundle"
        }
      ],
      "editor/context": [
        {
          "command": "databricksBundleInspector.inspectBundle",
          "group": "navigation",
          "when": "resourceFilename =~ /^databricks\\.ya?ml$/ || databricksBundleInspector.activeFileInBundle"
        }
      ],
      "webview/context": [
        {
          "command": "databricksBundleInspector.copySelection",
          "group": "5_cutcopypaste",
          "when": "webviewId == 'bundleInspector' && bundleInspectorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "databricksBundleInspector.copySelection",
          "when": "false"
        },
        {
          "command": "databricksBundleInspector.sidebar.inspect",
          "when": "false"
        },
        {
          "command": "databricksBundleInspector.sidebar.checkAgain",
          "when": "false"
        },
        {
          "command": "databricksBundleInspector.sidebar.openTarget",
          "when": "false"
        },
        {
          "command": "databricksBundleInspector.sidebar.openProblems",
          "when": "false"
        },
        {
          "command": "databricksBundleInspector.sidebar.openSignInTerminal",
          "when": "false"
        },
        {
          "command": "databricksBundleInspector.sidebar.checkAll",
          "when": "false"
        },
        {
          "command": "databricksBundleInspector.sidebar.openBundleFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "databricksBundleInspector.sidebar.checkAll",
          "when": "view == databricksBundleInspector.bundles",
          "group": "navigation"
        },
        {
          "command": "databricksBundleInspector.openGuide",
          "when": "view == databricksBundleInspector.bundles",
          "group": "help@1"
        },
        {
          "command": "databricksBundleInspector.reportIssue",
          "when": "view == databricksBundleInspector.bundles",
          "group": "help@2"
        }
      ],
      "view/item/context": [
        {
          "command": "databricksBundleInspector.sidebar.openBundleFile",
          "when": "view == databricksBundleInspector.bundles && viewItem == bundle",
          "group": "inline@1"
        },
        {
          "command": "databricksBundleInspector.sidebar.checkAgain",
          "when": "view == databricksBundleInspector.bundles && viewItem == bundle",
          "group": "inline@2"
        },
        {
          "command": "databricksBundleInspector.sidebar.inspect",
          "when": "view == databricksBundleInspector.bundles && viewItem == bundle",
          "group": "navigation@1"
        },
        {
          "command": "databricksBundleInspector.sidebar.openBundleFile",
          "when": "view == databricksBundleInspector.bundles && viewItem == bundle",
          "group": "navigation@2"
        },
        {
          "command": "databricksBundleInspector.sidebar.checkAgain",
          "when": "view == databricksBundleInspector.bundles && viewItem == bundle",
          "group": "navigation@3"
        },
        {
          "command": "databricksBundleInspector.sidebar.openSignInTerminal",
          "when": "view == databricksBundleInspector.bundles && viewItem == graph.signIn",
          "group": "inline"
        },
        {
          "command": "databricksBundleInspector.chooseCli",
          "when": "view == databricksBundleInspector.settings && viewItem == cli",
          "group": "inline"
        },
        {
          "command": "databricksBundleInspector.locateCli",
          "when": "view == databricksBundleInspector.settings && viewItem == cli.missing",
          "group": "inline@1"
        },
        {
          "command": "databricksBundleInspector.openCliInstallGuide",
          "when": "view == databricksBundleInspector.settings && viewItem == cli.missing",
          "group": "inline@2"
        },
        {
          "command": "databricksBundleInspector.chooseProfile",
          "when": "view == databricksBundleInspector.settings && viewItem == profile",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:uninstall": "node ./dist/uninstall.js",
    "build:ext": "node esbuild.js",
    "build:webview": "node scripts/repair-native-optional-deps.mjs && vite build",
    "build": "npm run build:ext && npm run build:webview",
    "package:vsix": "vsce package --no-dependencies",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "watch-tests": "tsc -p . --outDir out --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "compile": "npm run build:ext",
    "test": "npm run test:unit && npm run test:semantic",
    "test:unit": "jest --testPathIgnorePatterns semanticGraph.test.ts",
    "test:semantic": "jest src/test/unit/extension/semanticGraph.test.ts",
    "test:semantic:cli": "jest --config jest.semantic-cli.config.cjs",
    "test:variables:cli": "jest --config jest.variables-cli.config.cjs",
    "test:semantic:cli:matrix": "node scripts/run-semantic-cli-matrix.mjs",
    "test:schema-coverage": "jest --config jest.schema-coverage.config.cjs",
    "verify": "npm run test:unit && npm run test:semantic && npm run typecheck && npm run lint && npm run changelog:check",
    "changelog:check": "node scripts/changelog.mjs check",
    "changelog:preview": "node scripts/changelog.mjs preview",
    "changelog:release": "node scripts/changelog.mjs release",
    "deps:repair-native": "node scripts/repair-native-optional-deps.mjs",
    "cli:install-matrix": "node scripts/install-databricks-cli-matrix.mjs",
    "fixtures:update:validated-bundle": "node scripts/update-validated-bundle-fixture.mjs",
    "prepare": "husky",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "npm run build:ext && npm run build:webview && npm run build:e2e && node out/e2e/runTest.cjs",
    "test:e2e:watch": "npm run test:e2e -- --pause-ms 15000",
    "test:e2e:include": "npm run test:e2e -- --suite includeMistakes --fixture src/test/fixtures/include-mistakes",
    "test:e2e:issue-codes": "npm run test:e2e -- --suite issueCodes --fixture src/test/e2e/fixtures/issue-codes",
    "test:e2e:resource-files": "npm run test:e2e -- --suite resourceFiles --fixture src/test/e2e/fixtures/resource-files",
    "test:e2e:graph-refresh": "npm run test:e2e -- --suite graphRefresh --fixture src/test/e2e/fixtures/resource-files",
    "test:e2e:inspection-races": "npm run test:e2e -- --suite inspectionRaces --fixture src/test/e2e/fixtures/resource-files",
    "test:e2e:include:watch": "npm run test:e2e:include -- --pause-ms 10000",
    "test:e2e:always-on": "npm run test:e2e -- --suite alwaysOn --fixture src/test/e2e/fixtures/always-on",
    "test:e2e:always-on:watch": "npm run test:e2e:always-on -- --pause-ms 10000",
    "test:e2e:saved-file": "npm run test:e2e -- --suite savedFile --fixture src/test/e2e/fixtures/saved-file",
    "test:e2e:saved-file:other-case": "npm run test:e2e:saved-file -- --folder-case other",
    "test:e2e:targets": "npm run test:e2e -- --suite targets --fixture src/test/e2e/fixtures/targets",
    "test:e2e:targets:watch": "npm run test:e2e:targets -- --pause-ms 8000",
    "test:e2e:sidebar": "npm run test:e2e -- --suite sidebar --fixture src/test/e2e/fixtures/targets",
    "test:e2e:workspace-changes": "npm run test:e2e -- --suite workspaceChanges --fixture src/test/e2e/fixtures/workspace-changes",
    "test:e2e:themes": "npm run test:e2e -- --suite themes --fixture src/test/e2e/fixtures/themes"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ignore": "^7.0.14",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "tailwindcss": "^4.2.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "ovsx": {
      "@vscode/vsce": "$@vscode/vsce"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    },
    "babel-plugin-istanbul": {
      "test-exclude": "^8.0.0"
    },
    "@azure/identity": {
      "@azure/msal-node": "^7.1.0"
    }
  }
}
