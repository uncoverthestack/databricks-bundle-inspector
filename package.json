{
  "name": "databricks-bundle-inspector",
  "displayName": "Databricks Bundle Inspector",
  "description": "Catch Databricks bundle errors before you deploy. Missing files, unresolved variables, secret scope mix-ups and CLI warnings in the Problems panel, with an interactive graph of your jobs and pipelines.",
  "version": "0.5.0",
  "publisher": "UncoverTheStack",
  "icon": "resources/icon.png",
  "license": "Apache-2.0",
  "type": "module",
  "categories": [
    "Linters",
    "Visualization",
    "Data Science"
  ],
  "keywords": [
    "databricks",
    "databricks asset bundles",
    "declarative automation bundles",
    "dab",
    "dabs",
    "bundle validate",
    "lakeflow jobs",
    "lakeflow spark declarative pipelines",
    "spark declarative pipelines",
    "delta live tables",
    "dlt",
    "databricks jobs",
    "databricks.yml",
    "yaml",
    "linter",
    "validation",
    "secrets",
    "dag",
    "visualization"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": "22.x"
  },
  "homepage": "https://github.com/uncoverthestack/databricks-bundle-inspector",
  "qna": "https://github.com/uncoverthestack/databricks-bundle-inspector/issues",
  "bugs": {
    "url": "https://github.com/uncoverthestack/databricks-bundle-inspector/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uncoverthestack/databricks-bundle-inspector.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/databricks.yml",
    "workspaceContains:**/databricks.yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension runs the Databricks CLI on files in your workspace, so the folder must be trusted first."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "databricksBundleInspector.inspectBundle",
        "title": "Inspect Databricks Bundle",
        "enablement": "resourceFilename =~ /^databricks\\.ya?ml$/ || databricksBundleInspector.activeFileInBundle"
      },
      {
        "command": "databricksBundleInspector.openBundleIssues",
        "title": "Open Bundle Issues"
      },
      {
        "command": "databricksBundleInspector.chooseProfile",
        "title": "Choose Databricks Login Profile"
      },
      {
        "command": "databricksBundleInspector.copySelection",
        "title": "Copy"
      }
    ],
    "configuration": {
      "title": "Databricks Bundle Inspector",
      "properties": {
        "databricksBundleInspector.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional path to the Databricks CLI executable. When empty, the extension uses databricks from PATH."
        },
        "databricksBundleInspector.profile": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Profile from `~/.databrickscfg` to use when you pick a target in the graph. Needed when several profiles point at the same workspace; the graph then offers to choose one. Set it with the **Choose Databricks Login Profile** command. Not used by the structural preview, which needs no login."
        },
        "databricksBundleInspector.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Send anonymous usage data (features used, never paths, names or file contents) to help improve the extension. Nothing is sent when `#telemetry.telemetryLevel#` is not `all`, regardless of this setting. [What is collected](https://github.com/uncoverthestack/databricks-bundle-inspector#telemetry)",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "databricksBundleInspector.inspectBundle",
          "group": "navigation",
          "when": "resourceFilename =~ /^databricks\\.ya?ml$/ || databricksBundleInspector.activeFileInBundle"
        }
      ],
      "editor/context": [
        {
          "command": "databricksBundleInspector.inspectBundle",
          "group": "navigation",
          "when": "resourceFilename =~ /^databricks\\.ya?ml$/ || databricksBundleInspector.activeFileInBundle"
        }
      ],
      "webview/context": [
        {
          "command": "databricksBundleInspector.copySelection",
          "group": "5_cutcopypaste",
          "when": "webviewId == 'bundleInspector' && bundleInspectorHasSelection"
        }
      ],
      "commandPalette": [
        {
          "command": "databricksBundleInspector.copySelection",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:uninstall": "node ./dist/uninstall.js",
    "build:ext": "node esbuild.js",
    "build:webview": "node scripts/repair-native-optional-deps.mjs && vite build",
    "build": "npm run build:ext && npm run build:webview",
    "package:vsix": "vsce package --no-dependencies",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "watch-tests": "tsc -p . --outDir out --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "compile": "npm run build:ext",
    "test": "npm run test:unit && npm run test:semantic",
    "test:unit": "jest --testPathIgnorePatterns semanticGraph.test.ts",
    "test:semantic": "jest src/test/unit/extension/semanticGraph.test.ts",
    "test:semantic:cli": "jest --config jest.semantic-cli.config.cjs",
    "test:variables:cli": "jest --config jest.variables-cli.config.cjs",
    "test:semantic:cli:matrix": "node scripts/run-semantic-cli-matrix.mjs",
    "test:schema-coverage": "jest --config jest.schema-coverage.config.cjs",
    "verify": "npm run test:unit && npm run test:semantic && npm run typecheck && npm run lint",
    "deps:repair-native": "node scripts/repair-native-optional-deps.mjs",
    "cli:install-matrix": "node scripts/install-databricks-cli-matrix.mjs",
    "fixtures:update:validated-bundle": "node scripts/update-validated-bundle-fixture.mjs",
    "prepare": "husky",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "npm run build:ext && npm run build:webview && npm run build:e2e && node out/e2e/runTest.cjs",
    "test:e2e:watch": "npm run test:e2e -- --pause-ms 15000",
    "test:e2e:include": "npm run test:e2e -- --suite includeMistakes --fixture src/test/fixtures/include-mistakes",
    "test:e2e:issue-codes": "npm run test:e2e -- --suite issueCodes --fixture src/test/e2e/fixtures/issue-codes",
    "test:e2e:resource-files": "npm run test:e2e -- --suite resourceFiles --fixture src/test/e2e/fixtures/resource-files",
    "test:e2e:graph-refresh": "npm run test:e2e -- --suite graphRefresh --fixture src/test/e2e/fixtures/resource-files",
    "test:e2e:inspection-races": "npm run test:e2e -- --suite inspectionRaces --fixture src/test/e2e/fixtures/resource-files",
    "test:e2e:include:watch": "npm run test:e2e:include -- --pause-ms 10000",
    "test:e2e:always-on": "npm run test:e2e -- --suite alwaysOn --fixture src/test/e2e/fixtures/always-on",
    "test:e2e:always-on:watch": "npm run test:e2e:always-on -- --pause-ms 10000",
    "test:e2e:saved-file": "npm run test:e2e -- --suite savedFile --fixture src/test/e2e/fixtures/saved-file",
    "test:e2e:saved-file:other-case": "npm run test:e2e:saved-file -- --folder-case other",
    "test:e2e:targets": "npm run test:e2e -- --suite targets --fixture src/test/e2e/fixtures/targets",
    "test:e2e:themes": "npm run test:e2e -- --suite themes --fixture src/test/e2e/fixtures/themes"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "ignore": "^7.0.10",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "tailwindcss": "^4.2.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "ovsx": {
      "@vscode/vsce": "$@vscode/vsce"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    },
    "babel-plugin-istanbul": {
      "test-exclude": "^8.0.0"
    },
    "@azure/identity": {
      "@azure/msal-node": "^7.1.0"
    }
  }
}
