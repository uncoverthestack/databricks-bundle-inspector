{
  "bundle": {
    "name": "multi-job-dag"
  },
  "resources": {
    "jobs": {
      "cleanup_job": {
        "name": "Cleanup Job",
        "tasks": [
          {
            "spark_python_task": {
              "python_file": "./src/cleanup.py"
            },
            "task_key": "cleanup"
          }
        ]
      },
      "ingest_job": {
        "name": "Ingest Job",
        "tasks": [
          {
            "notebook_task": {
              "notebook_path": "./src/extract.py"
            },
            "task_key": "extract"
          },
          {
            "depends_on": [
              {
                "task_key": "extract"
              }
            ],
            "spark_python_task": {
              "python_file": "./src/transform.py"
            },
            "task_key": "transform"
          },
          {
            "depends_on": [
              {
                "task_key": "transform"
              }
            ],
            "sql_task": {
              "file": {
                "path": "./src/load.sql"
              },
              "warehouse_id": "warehouse-main"
            },
            "task_key": "load"
          }
        ],
        "trigger": {
          "periodic": {
            "interval": 2,
            "unit": "DAYS"
          }
        }
      }
    }
  },
  "targets": {
    "default": {}
  }
}
