{
  "bundle": {
    "name": "broken-job"
  },
  "resources": {
    "jobs": {
      "broken_job": {
        "name": "Broken Job",
        "tasks": [
          {
            "notebook_task": {
              "notebook_path": "./src/missing.py"
            },
            "task_key": "missing_notebook"
          },
          {
            "libraries": [
              {
                "whl": "./dist/missing.whl"
              }
            ],
            "sql_task": {
              "file": {
                "path": "./src/query.sql"
              },
              "warehouse_id": "${var.missing_warehouse}"
            },
            "task_key": "unresolved_sql"
          }
        ]
      }
    }
  },
  "targets": {
    "default": {}
  },
  "variables": {
    "defined": {
      "default": "present"
    }
  }
}
