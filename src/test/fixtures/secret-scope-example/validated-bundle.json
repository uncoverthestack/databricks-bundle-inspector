{
  "bundle": {
    "name": "secret-scope-example"
  },
  "include": [
    "resources/sample_python.job.yml",
    "resources/sample_python.pipeline.yml",
    "resources/variables.yml"
  ],
  "resources": {
    "jobs": {
      "config_job": {
        "name": "config_job",
        "tasks": [
          {
            "notebook_task": {
              "base_parameters": {
                "start_time": "2021-01-01"
              },
              "notebook_path": "../src/notebook.ipynb"
            },
            "task_key": "notebook_task"
          },
          {
            "depends_on": [
              {
                "task_key": "notebook_task"
              }
            ],
            "sql_task": {
              "file": {
                "path": "../src/query_file.sql"
              },
              "warehouse_id": "0123456789"
            },
            "task_key": "query_file_sql"
          },
          {
            "sql_task": {
              "file": {
                "path": "../src/query_file_sql_no_extension"
              },
              "warehouse_id": "0123456789"
            },
            "task_key": "query_file_sql_no_extension"
          }
        ],
        "trigger": {
          "periodic": {
            "interval": 1,
            "unit": "DAYS"
          }
        }
      }
    },
    "pipelines": {
      "sample_python_pipeline": {
        "catalog": "${var.catalog}",
        "libraries": [
          {
            "glob": {
              "include": "../src/transformations/**"
            }
          }
        ],
        "name": "default_python_pipeline",
        "schema": "${var.schema}",
        "serverless": true
      }
    }
  },
  "targets": {
    "dev": {
      "default": true,
      "mode": "development",
      "variables": {
        "warehouse_id": {
          "default": "dev-warehouse-id"
        }
      },
      "workspace": {
        "host": "https://example.databricks.com"
      }
    },
    "prod": {
      "default": true,
      "mode": "production",
      "variables": {
        "warehouse_id": {
          "default": "prod-warehouse-id"
        }
      },
      "workspace": {
        "host": "https://example.databricks.com"
      }
    }
  },
  "variables": {
    "catalog": {
      "default": "development",
      "description": "The catalog to use"
    },
    "schema": {
      "default": "inspector",
      "description": "The schema to use"
    },
    "warehouse_id": {
      "default": "general-warehouse-id",
      "description": "The warehouse to use"
    }
  }
}
